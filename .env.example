# Copy to .env and fill in. .env is gitignored. Every variable the app reads
# from the environment is listed here with a safe placeholder; config/settings.py
# (pydantic-settings) is the single reader. Add a line here the moment a new var is introduced.

# --- Inference: LLM Provider selector ---
# The agent loop runs on ONE selectable LLM Provider. Every one has a free path:
#   gemini      free credits on Google AI Studio (the default).
#   openrouter  OpenAI-compatible gateway with `:free` model ids.
#   modal       open-source models you serve yourself on Modal's $30 of free credits.
# Opt in by setting LLM_PROVIDER + that provider's secret(s). Left unset it stays on gemini, so an
# existing .env that only sets GEMINI_API_KEY keeps working untouched.
# LLM_PROVIDER=gemini / openrouter / modal

# gemini (default): google-genai API-key path.
GEMINI_API_KEY=changeme
# Model id is config-driven; override the default (gemini-2.5-flash) here.
# GEMINI_MODEL=gemini-2.5-flash

# openrouter (LLM_PROVIDER=openrouter): OpenAI-compatible gateway with `:free` models.
OPENROUTER_API_KEY=changeme
# The default `openrouter/free` is the Free Models Router: it auto-routes to whatever free model is
# up and filters for tool-calling, so a single congested provider won't hard-block you with 429s.
# Free models share a pool with daily caps; adding $10 of credits raises the free-tier daily cap
# (~50 -> ~1000 req/day) and unlocks BYOK — free models still cost $0 to run.
# Swap to a pinned id (pick a tool-capable one, e.g. meta-llama/llama-3.3-70b-instruct:free) if you
# want a stricter guarantee than the router.
# OPENROUTER_MODEL=openrouter/free

# modal (LLM_PROVIDER=modal): open-source models on your own OpenAI-compatible Auto Endpoint.
# Pick a model + create the endpoint by following MODAL_MODELS.md (selection, `modal endpoint
# create`, proxy tokens). Two DISTINCT Modal credential pairs live below — don't conflate them:
#
# (1) ACCOUNT tokens — authenticate the Modal CLI itself (create/deploy endpoints + the sandbox),
#     NOT how decode calls the endpoint. Set via
#     `modal token set --token-id <id> --token-secret <secret>` (writes ~/.modal.toml) or here.
MODAL_TOKEN_ID=changeme
MODAL_TOKEN_SECRET=changeme
#
# (2) ENDPOINT vars — how decode reaches your served model. The URL has no default (per-endpoint
#     deploy output); the gateway uses it as base_url = {MODAL_ENDPOINT_URL}/v1. The default model
#     is MODAL_MODELS.md's best-fit pick (native OpenAI tool-calling); swap only to a tool-capable id.
# MODAL_ENDPOINT_URL=https://your-workspace--your-app.modal.run
# MODAL_ENDPOINT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
#
#     PROXY tokens (OPTIONAL) — endpoint request headers `Modal-Key` (wk-...) / `Modal-Secret`
#     (ws-...) from `modal workspace proxy-tokens create`. These are NOT the account tokens above.
#     Set BOTH for an authenticated endpoint, or omit BOTH for one created with `--unauthenticated`.
# MODAL_PROXY_TOKEN_ID=wk-...
# MODAL_PROXY_TOKEN_SECRET=ws-...

# --- Logging ---
# LOG_LEVEL=INFO
# Logs go to a file, OFF the terminal. Default: <cwd>/.decode/logs/decode.log.
# Set DECODE_LOG_FILE="" (empty) to disable file logging entirely.
# DECODE_LOG_FILE=.decode/logs/decode.log

# --- Observability: Opik ---
OPIK_API_KEY=changeme
# OPIK_WORKSPACE=default

# --- Durability runtime: Kitaru ---
# KITARU_API_KEY=changeme

# --- Local persistence ---
# Conversation log / durability store (SQLite). Defaults to a project-local file.
# DECODE_DB_PATH=./decode.db
# Append-only JSONL session log dir (used by `decode --resume`). Defaults to .decode/sessions
# (gitignored). Override to relocate where session logs are written.
# SESSIONS_DIR=.decode/sessions

# --- Context compaction ---
# Window-relative two-tier compaction (ADR-0006). Defaults are safe; uncomment only to tune.
# COMPACTION_ENABLED gates ONLY the automatic cascade (manual `/compact` always runs).
# COMPACTION_ENABLED=true
# The active model's MAX *input* context window, in tokens — set this to YOUR active model's input
# window. Default is Gemini 2.5 Flash's window (1048576). Single source of truth (also the TUI gauge).
# COMPACTION_CONTEXT_WINDOW_TOKENS=1048576
# Thresholds are window-relative RESERVES: a tier fires when input tokens reach window * (1 - reserve),
# measured from provider-reported input tokens. Full fires at 80% full (reserve 0.20); micro fires
# EARLIER at 60% full (reserve 0.40). Keep micro's reserve > full's so micro fires first.
# COMPACTION_RESERVE_FRACTION=0.20
# MICROCOMPACTION_RESERVE_FRACTION=0.40
# Token budget of the recent tail kept verbatim by full compaction (snapped to a turn boundary).
# COMPACTION_KEEP_RECENT_TOKENS=20000
# Governs ONLY the on-exit MEMORY.md compressor: when true it compresses at the line cap instead of
# plain drop-oldest (which always remains the fallback).
# MEMORY_COMPRESSION_ENABLED=true

# --- Orchestration ---
# Upper bound (seconds) for the ungated `sleep` tool; a larger request is capped to this.
# SLEEP_MAX_S=60.0

# --- Permissions ---
# Optional user allow/deny rules: {"permissions": {"allow": [...], "deny": [...]}}. Missing or
# malformed is non-fatal (the gate falls back to mode-only). Defaults to .decode/settings.json.
# PERMISSIONS_FILE=.decode/settings.json

# --- Skills ---
# Project-local skills are directories `<name>/SKILL.md` (frontmatter + body) under this dir, not
# flat `*.md` files. A skill is keyed by its frontmatter `name` (the directory name is cosmetic); a
# project skill whose `name` matches a built-in overrides it. A skill directory may also ship bundled
# `references/`/`examples/`/`scripts/` siblings, loaded on demand. Missing dir → built-ins only.
# Defaults to .decode/skills.
# SKILLS_DIR=.decode/skills

# --- LSP / code intelligence ---
# Code intelligence via a stdio Language Server (ADR-0007). Best-effort everywhere: an absent, old, or
# slow server degrades silently (no `lsp` tool effect, no inline diagnostics) — never breaks a turn.
# LSP_ENABLED is the master gate for the WHOLE feature; false means no server is ever spawned.
# LSP_ENABLED=true
# The server is swappable. Default spawns `ty server` (Astral's type-checker, installed via the dev
# group); drop in `pylsp` or any stdio LSP server by overriding the command + args. The spawn is
# [LSP_SERVER_COMMAND, *LSP_SERVER_ARGS]. LSP_SERVER_ARGS is parsed as a JSON list.
# LSP_SERVER_COMMAND=ty
# LSP_SERVER_ARGS=["server"]
# Gates ONLY the passive diagnostics-on-edit enricher (the errors-only block appended after a .py
# write/edit); the active `lsp` tool is unaffected. Both still ride LSP_ENABLED.
# LSP_DIAGNOSTICS_ON_EDIT=true
# Per-request best-effort wall-clock timeout in seconds (the server's initialize is bounded too).
# Must be > 0. Default 10.0; the lazy single spawn per project root amortizes the startup cost.
# LSP_REQUEST_TIMEOUT_S=10.0

# --- Kitaru durable runtime ---
# A SECOND, non-interactive entry path (`decode run "<task>"`, ADR-0008) that runs the same agent as a
# Kitaru Durable Flow — it gets Replay/Wait instead of mid-turn steering/abort. It leaves the
# interactive TUI and its JSONL session log untouched; the REPL never imports Kitaru. `local` is the
# starting Kitaru stack (the runtime extra). These vars are read only by the runtime (no readers yet).
# RUNTIME_ENABLED master-gates the WHOLE feature; false means `decode run` exits with a friendly line
# and never builds a flow.
# RUNTIME_ENABLED=true
# KitaruAgent checkpoint granularity. Default `calls` (per model/tool call): every `decode run` is
# replay-ready — a replay can anchor before a specific model call. Loop-safe on gemini, the wired
# provider (flow mode uses a keep-alive-free HTTP client so Kitaru's per-call event loops don't reuse a
# connection across loops; openrouter/modal would need the same wiring). `turn` (one coarse checkpoint
# per run) is a cheaper opt-out, but a `turn` run can only
# be replayed whole. HITL always forces `calls`. A value outside {turn, calls} fails fast at load.
# RUNTIME_CHECKPOINT_STRATEGY=calls
# The durable Wait (HITL) poll timeout in seconds (matches Kitaru's local 600s default). Must be > 0.
# RUNTIME_WAIT_TIMEOUT_S=600.0
# Credentials proxy (opt-in, verify-first): when true, flow-mode model construction resolves the
# provider API key through Kitaru secrets instead of the SecretStr in settings, so a deployed flow
# carries handles, not raw keys. Off by default — the least-exampled Kitaru surface (ADR-0008 §5).
# RUNTIME_CREDENTIALS_PROXY_ENABLED=false
# The Kitaru secret name the credentials proxy reads the provider key from when enabled above. The
# secret-store config source below reuses this same secret name.
# RUNTIME_SECRET_NAME=decode-llm-creds
# Secret-store config source (opt-in, headless-only): when true, a `decode run` flow hydrates the
# WHOLE config surface (any var in this file — provider, model, keys, tuning) from the RUNTIME_SECRET_NAME
# Kitaru secret. Values land in the Settings object ONLY — never os.environ — so a model-chosen `bash`
# never inherits them; the real process env still overrides the secret. Off by default; bare `decode`
# (the REPL) never reads the secret and never imports kitaru (ADR-0008 §5). This is NOT the credential
# proxy (mitmproxy header injection) — that is a separate, deferred sandbox-milestone feature.
# RUNTIME_SECRET_STORE_CONFIG=false

# --- Sandboxing ---
# Where model-chosen `bash` commands execute (ADR-0011). One CommandExecutor is selected once at
# startup by SANDBOX_MODE and fixed for the session:
#   none    the default — today's LocalExecutor (a host subprocess, cwd-pinned). ZERO behavior change:
#           every existing .env keeps working untouched, no docker/modal needed.
#   docker  a session-persistent LOCAL container whose /workspace is the project's .decode/sandbox/
#           scratch — the repo tree is NOT mounted (file tools keep working host-side) and
#           .decode/skills/ rides in read-only; cd/export/installs persist across bash calls. Needs a
#           running Docker daemon; the startup guard exits with a friendly line if it is unreachable.
#   modal   a session-persistent REMOTE modal.Sandbox starting at /workspace EMPTY except the
#           project's .decode/skills/ (seeded so skill scripts run remotely) — NO other local files
#           are synced (the model works with code via git clone/fetch/generate). Needs Modal account
#           creds (MODAL_TOKEN_ID + MODAL_TOKEN_SECRET, or `modal token set`); presence-only guard.
# SANDBOX_MODE=none
# The worker image: docker pulls it directly; modal maps it via modal.Image.from_registry(...). Must
# include bash (the stock default does).
# SANDBOX_IMAGE=python:3.12-slim
# The host directory backing the docker sandbox's /workspace (cwd-relative, created on first use).
# The repo tree is never mounted into the sandbox — only this scratch (+ .decode/skills read-only).
# SANDBOX_WORKSPACE_DIR=.decode/sandbox
# Max lifetime (seconds) of a REMOTE (modal) sandbox before Modal reaps it; docker's session container
# has no lifetime cap. Must be > 0.
# SANDBOX_TIMEOUT_S=600.0
# Credential Proxy (opt-in, HEADLESS + DOCKER only): when true, a headless `decode run` flow in docker
# mode routes the worker's outbound tool calls through a mitmproxy addon container that injects
# credentials AFTER the request leaves the worker — so the worker (which runs model-chosen commands)
# never holds a secret. Enabling this flag alone injects nothing: also add a SandboxProxyRule to
# DEFAULT_PROXY_RULES in src/decode/sandbox/proxy.py and create its Kitaru secret (`kitaru secrets set
# …`). Off by default; the REPL never builds it (see the README Sandboxing section, ADR-0011 §6).
# SANDBOX_CREDENTIAL_PROXY_ENABLED=false
# The mitmproxy addon container image the Credential Proxy runs.
# SANDBOX_PROXY_IMAGE=mitmproxy/mitmproxy
