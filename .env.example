# Copy to .env and fill in. .env is gitignored. Every variable the app reads
# from the environment is listed here with a safe placeholder; config/settings.py
# (pydantic-settings) is the single reader. Add a line here the moment a new var is introduced.

# --- Inference: provider selector (ADR-0005) ---
# Which backend the agent loop uses: gemini (default) | openrouter | modal.
# LLM_PROVIDER=gemini

# --- Inference: Gemini (google-genai) ---
GEMINI_API_KEY=changeme
# Model id is config-driven; override the default (gemini-2.5-flash) here.
# GEMINI_MODEL=gemini-2.5-flash

# --- Logging ---
# LOG_LEVEL=INFO
# Logs go to a file, OFF the terminal. Default: <cwd>/.decode/logs/decode.log.
# Set DECODE_LOG_FILE="" (empty) to disable file logging entirely.
# DECODE_LOG_FILE=.decode/logs/decode.log

# --- Inference: OpenRouter (OpenAI-compatible gateway) ---
OPENROUTER_API_KEY=changeme
# OPENROUTER_MODEL=qwen/qwen3-coder:free

# --- Remote sandbox + model serving: Modal ---
# Set via `modal token set --token-id <your-token-id> --token-secret <your-token-secret>`
# (writes ~/.modal.toml) or these env vars.
MODAL_TOKEN_ID=changeme
MODAL_TOKEN_SECRET=changeme

# Modal Auto Endpoint (LLM_PROVIDER=modal); proxy tokens optional (--unauthenticated).
# MODAL_ENDPOINT_URL=https://your-workspace--your-app.modal.run
# MODAL_ENDPOINT_MODEL=openai/gpt-oss-120b
MODAL_PROXY_TOKEN_ID=changeme
MODAL_PROXY_TOKEN_SECRET=changeme

# --- Observability: Opik ---
OPIK_API_KEY=changeme
# OPIK_WORKSPACE=default

# --- Durability runtime: Kitaru ---
# KITARU_API_KEY=changeme

# --- Local persistence ---
# Conversation log / durability store (SQLite). Defaults to a project-local file.
# DECODE_DB_PATH=./decode.db
# Append-only JSONL session log dir (used by `decode --resume`). Defaults to .decode/sessions
# (gitignored). Override to relocate where session logs are written.
# SESSIONS_DIR=.decode/sessions

# --- Orchestration ---
# Upper bound (seconds) for the ungated `sleep` tool; a larger request is capped to this.
# SLEEP_MAX_S=60.0

# --- Permissions ---
# Optional user allow/deny rules: {"permissions": {"allow": [...], "deny": [...]}}. Missing or
# malformed is non-fatal (the gate falls back to mode-only). Defaults to .decode/settings.json.
# PERMISSIONS_FILE=.decode/settings.json

# --- Skills ---
# Project-local skills are directories `<name>/SKILL.md` (frontmatter + body) under this dir, not
# flat `*.md` files. A skill is keyed by its frontmatter `name` (the directory name is cosmetic); a
# project skill whose `name` matches a built-in overrides it. A skill directory may also ship bundled
# `references/`/`examples/`/`scripts/` siblings, loaded on demand. Missing dir → built-ins only.
# Defaults to .decode/skills.
# SKILLS_DIR=.decode/skills
